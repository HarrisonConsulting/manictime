# ManicTime API Client Environment Variables
# Copy this file to .env and modify as needed

# Server Configuration
MANICTIME_USE_EXTERNAL_SERVER=False
MANICTIME_SERVER_URL=http://localhost:8080
MANICTIME_DOCKER_URL=http://localhost:8080

# Authentication
MANICTIME_ADMIN_USERNAME=admin
MANICTIME_ADMIN_PASSWORD=admin123

# Connection Settings
MANICTIME_MAX_RETRIES=5
MANICTIME_RETRY_DELAY=2